<div class="tab spheres" data-group="{{ dataGroup }}" data-tab="spheres">
    <!-- Header area containing Spheres attributes -->
    <div class="attribute-grid grid grid-5col">
        <span class="block-header sop-header flexrow">{{ localize "PF1SPHERES.SpheresOfPower" }}</span>
        <span class="block-header som-header flexrow">{{ localize "PF1SPHERES.SpheresOfMight" }}</span>
        {{#each attributeGrid as |element |}}
            <div class="{{ element.attribute }} attribute" data-tooltip-sphere="{{element.attribute}}">
                <h4 class="attribute-name box-title {{ element.rollable }}">{{ element.label }}</h4>
                <span class="attribute-value large">{{ element.total }}</span>
            </div>
        {{/each }}
    </div>
    <!-- Tracked resources: spell pool and martial focus -->
    <div class="spheres-resources flexrow">
        {{#if spellPoints.max }}
            <div class="form-group spell-points" data-tooltip="@spheres.spellPoints.value / @spheres.spellPoints.max">
                <label>{{ localize "PF1SPHERES.SpellPoints" }}</label>
                <input type="number" class="pf1s-spell-points" value="{{ spellPoints.value }}" min="0" max="{{ spellPoints.max }}" data-dtype="Number">
                <span>/ {{ spellPoints.max }}</span>
            </div>
        {{/if }}
        {{#if weatherCaster }}
            <button type="button" class="pf1s-control-weather"><i class="fas fa-cloud-bolt"></i> {{ localize "PF1SPHERES.Weather.ControlButton" }}</button>
        {{/if }}
        {{#if alchemist }}
            <button type="button" class="pf1s-prepare-formulae"><i class="fas fa-flask"></i> {{ localize "PF1SPHERES.Auto.PrepareFormulae" }}</button>
        {{/if }}
        {{#if blaster }}
            <button type="button" class="pf1s-build-blasts" data-tooltip="PF1SPHERES.Auto.BuildBlastsHint"><i class="fas fa-burst"></i> {{ localize "PF1SPHERES.Auto.BuildBlasts" }}</button>
        {{/if }}
        {{#if spellPoints.max }}
            <button type="button" class="pf1s-msb-vs" data-tooltip="PF1SPHERES.Auto.MsbVsHint"><i class="fas fa-wand-sparkles"></i> {{ localize "PF1SPHERES.Auto.MsbVs" }}</button>
        {{/if }}
        <div class="form-group martial-focus" data-tooltip="@spheres.martialFocus">
            <label>{{ localize "PF1SPHERES.MartialFocus" }}</label>
            <input type="checkbox" name="flags.pf1spheres.martialFocus" data-dtype="Boolean" {{checked martialFocus}}>
        </div>
    </div>
    {{#if sequence }}
    <div class="spheres-sequence flexrow">
        <label><strong>{{ localize "PF1SPHERES.Auto.Sequence" }}</strong>: {{ sequence.length }} / {{ sequence.max }}{{#if sequence.length}} ({{ localize "PF1SPHERES.Auto.Inspired" }} +{{ sequence.bonus }}){{/if}}</label>
        <button type="button" class="pf1s-seq-add" data-tooltip="PF1SPHERES.Auto.AddLink"><i class="fas fa-plus"></i></button>
        <button type="button" class="pf1s-seq-sub" data-tooltip="PF1SPHERES.Auto.LoseLink"><i class="fas fa-minus"></i></button>
        <button type="button" class="pf1s-seq-end">{{ localize "PF1SPHERES.Auto.EndSequence" }}</button>
        {{#if sequence.imbueOptions.length }}
        <select class="pf1s-seq-imbue" data-tooltip="PF1SPHERES.Auto.Imbue">
            <option value="">{{ localize "PF1SPHERES.Auto.Imbue" }}: —</option>
            {{#each sequence.imbueOptions as |o| }}<option value="{{ o.value }}" {{#if o.selected }}selected{{/if }}>{{ o.label }}</option>{{/each }}
        </select>
        {{else }}
        <input type="text" class="pf1s-seq-imbue" value="{{ sequence.imbue }}" placeholder="{{ localize "PF1SPHERES.Auto.Imbue" }}">
        {{/if }}
    </div>
    {{#if sequence.imbueChosen }}
    <div class="spheres-imbue">
        <p><strong>{{ sequence.imbueChosen.name }} ({{ localize "PF1SPHERES.Auto.Imbue" }}):</strong> {{ sequence.imbueChosen.text }}</p>
        {{#each sequence.imbueChosen.finishers as |f| }}<p><strong>{{ f.name }} ({{ localize "PF1SPHERES.Auto.Finisher" }}):</strong> {{ f.text }}</p>{{/each }}
    </div>
    {{/if }}
    {{/if }}
    {{#if effects.length }}
    <div class="spheres-effects">
        <h4 class="block-header">{{ localize "PF1SPHERES.Auto.ActiveEffects" }}</h4>
        <ol class="item-list">
            {{#each effects as |e|}}
                <li class="flexrow sphere-effect" data-effect-id="{{ e.id }}">
                    <img src="{{ e.img }}" alt="" class="effect-img">
                    <span class="effect-name">{{ e.name }}</span>
                    <span class="effect-time">{{#if e.concentration}}{{ localize "PF1SPHERES.Auto.Concentrating" }}{{else}}{{ e.remaining }}{{/if}}</span>
                    {{#if e.canPersist}}<button type="button" class="pf1s-effect-persist" data-tooltip="PF1SPHERES.Auto.PersistHint">{{ localize "PF1SPHERES.Auto.Persist" }}</button>{{/if}}
                    <button type="button" class="pf1s-effect-end">{{ localize "PF1SPHERES.Auto.End" }}</button>
                </li>
            {{/each}}
        </ol>
    </div>
    {{/if }}
    {{#if marks.length }}
    <div class="spheres-marks flexrow">
        <span><strong>{{ localize "PF1SPHERES.Auto.YourMarks" }}</strong>: {{#each marks}}{{ this.label }} ({{ this.token }}){{#unless @last}}, {{/unless}}{{/each}}</span>
        <button type="button" class="pf1s-clear-marks">{{ localize "PF1SPHERES.Auto.ClearMarks" }}</button>
    </div>
    {{/if }}
    <div class="spheres-traditions">
        <h4 class="block-header flexrow">
            <span>{{ localize "PF1SPHERES.Traditions" }}</span>
            <a class="pf1s-tradition-new" data-kind="martial" data-tooltip="PF1SPHERES.NewMartialTradition"><i class="fas fa-plus"></i> {{ localize "PF1SPHERES.MartialTradition" }}</a>
            <a class="pf1s-tradition-new" data-kind="casting" data-tooltip="PF1SPHERES.NewCastingTradition"><i class="fas fa-plus"></i> {{ localize "PF1SPHERES.CastingTradition" }}</a>
        </h4>
        <ol class="item-list">
        {{#each traditions as |t| }}
            <li class="flexrow tradition">
                <img src="{{ t.img }}" alt="" class="tradition-img">
                <a class="pf1s-open-item tradition-name" data-item-id="{{ t.id }}"><strong>{{ t.name }}</strong></a>
                <span class="tradition-kind">{{ t.kindLabel }}</span>
                <span class="tradition-members">{{#each t.members as |m| }}<a class="pf1s-open-item" data-item-id="{{ m.id }}">{{ m.name }}</a>{{#unless @last }}, {{/unless }}{{else }}<em>{{ localize "PF1SPHERES.TraditionEmpty" }}</em>{{/each }}</span>
            </li>
        {{/each }}
        </ol>
    </div>
    <!-- Spheres with their name, talent count, CL, and talent collabpsible -->
    <ol class="spheres-list">
        {{#each allSpheres as |sphere|}}
            {{#if sphere.hasTalents }}
                <li class="sphere grid" data-sphere="{{ sphere.sphere }}">
                    <img class="sphere-icon" alt="{{ sphere.label }}" src="{{ sphere.icon }}" />
                    <div class="block-header sphere-label flexrow">{{ sphere.label }}</div>
                    <div class="sphere-info">
                      <span data-tooltip="@spheres.talents.{{sphere.sphere}}.total: {{sphere.talentCounts.total}} <br> @spheres.talents.{{sphere.sphere}}.excluded: {{sphere.talentCounts.excluded}}"
                        >
                          <b>{{ localize "PF1SPHERES.TalentPlural" }}</b>: {{ sphere.talentCounts.total }}
                          {{#if sphere.talentCounts.excluded}} ({{ sphere.talentCounts.excluded }}) {{/if }}
                      </span>
                    </div>
                <span class="sphere-level-label">{{ sphere.levelLabel }}</span>
                <div class="sphere-level-value" data-tooltip-sphere="{{sphere.tooltipId}}">
                    {{ sphere.total }}
                </div>
                <div class="block-header expand-sphere flexrow">
                    {{ localize "PF1SPHERES.TalentPlural" }}
                    <i class="fas fa-angle-double-down {{#if sphere.expandTalents }}rotate-arrow{{/if }}"></i>
                </div>
                <ol class="item-list sphere-talents" {{#if (ne sphere.expandTalents true) }} style="display: none" {{/if }}>
                    <!-- Individual talent-->
                    {{#each sphere.talents as |talent|}}
                        <li class="talent grid item" data-item-id="{{ talent.id }}">
                            <div class="talent-icon">
                                <img src="{{ talent.img }}" alt="Sphere icon for {{ talent.name }}"/>
                                <i class="fas fa-comment"></i>
                            </div>
                            <div class="talent-name">
                                <b>{{ talent.name }}</b>
                                {{#each talent.tags as |tag|}}
                                    <span class="talent-tag">{{ tag }}</span>
                                {{/each }}
                            </div>
                            <div class="talent-activation">{{ talent.activationType }}</div>
                            <div class="talent-use">
                                {{#if talent.hasAction }}
                                    <a class "item-control item-action action roll" data-tooltip="PF1.UseFeat">
                                      <i class ="fas fa-dice-d20"></i>
                                    </a>
                                </img>
                            {{/if }}
                        </div>
                        {{!-- <div class="talent-controls"></div> --}}
                    </li>
                {{/each }}
            </ol>
        </li>
    {{/if }}
{{/each }}
</ol>
</div>
