<form autocomplete="off">
    <div class="form-group">
        <label for="{{appId}}.showSpheresTab">{{localize "PF1SPHERES.Settings.ShowSpheresTab"}}</label>
        <div class="form-fields">
            <input type="checkbox" id="{{appId}}.showSpheresTab" name="flags.pf1spheres.showSpheresTab" data-dtype="Boolean" {{checked pf1sFlags.showSpheresTab}}>
        </div>
        <p class="hint">{{localize "PF1SPHERES.Settings.ShowSpheresTabNote"}}</p>
    </div>
    <div>
        {{! Abilities}}
        {{#each abilitySettings}}
            <div class="form-group">
                <label for="{{@root.appId}}.{{name}}">{{localize label}}</label>
                <div class="form-fields">
                    <select id="{{@root.appId}}.{{name}}"
                            name="{{name}}"
                            data-dtype="String">
                        {{selectOptions options selected=value blank="PF1.None" localize=true}}
                    </select>
                </div>
                <p class="hint">{{localize "PF1SPHERES.Settings.AbilitySettingNote" rollPath=rollPath}}</p>
            </div>
        {{/each}}
    </div>
</form>
